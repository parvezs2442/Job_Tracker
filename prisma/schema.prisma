datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

enum JobStatus {
  WISHLIST
  APPLIED
  OA
  INTERVIEW
  OFFER
  REJECTED
}

enum InterviewType {
  HR
  TECHNICAL
  MANAGERIAL
  FINAL
}

enum InterviewResult {
  PENDING
  PASSED
  FAILED
}

model User {
  id            String         @id @default(uuid())
  name          String
  email         String         @unique
  password      String
  role          Role           @default(USER)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  jobs          Job[]
  activityLogs  ActivityLog[]
  notifications Notification[]
}

model Job {
  id              String        @id @default(uuid())
  title           String
  company         String
  location        String?
  salary          String?
  platform        String?
  status          JobStatus     @default(WISHLIST)
  applicationDate DateTime      @default(now())
  notes           String?
  jobUrl          String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  interviews      Interview[]
  activityLogs    ActivityLog[]
}

model Interview {
  id            String          @id @default(uuid())
  jobId         String
  job           Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  round         String
  type          InterviewType
  scheduledDate DateTime
  feedback      String?
  result        InterviewResult @default(PENDING)
  createdAt     DateTime        @default(now())
}

model ActivityLog {
  id        String   @id @default(uuid())
  action    String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId     String?
  job       Job?     @relation(fields: [jobId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  isRead    Boolean  @default(false)
  type      String   // "REMINDER", "STATUS_CHANGE", "OFFER"
  createdAt DateTime @default(now())
}
